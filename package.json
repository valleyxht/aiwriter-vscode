{
  "name": "aiwriter",
  "displayName": "AI Writer - 小说创作助手",
  "description": "VSCode 插件，用于小说创作和 AI 辅助写作",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:aiwriter.sidebar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiwriter",
          "title": "AI Writer",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aiwriter": [
        {
          "type": "webview",
          "id": "aiwriter.sidebar",
          "name": "写作助手",
          "contextualTitle": "AI Writer"
        }
      ]
    },
    "commands": [
      {
        "command": "aiwriter.researchCatalog",
        "title": "资料目录与章节摘要",
        "category": "AI Writer"
      },
      {
        "command": "aiwriter.newSession",
        "title": "新建写作会话",
        "icon": "$(add)",
        "category": "AI Writer"
      },
      {
        "command": "aiwriter.collectSelectedText",
        "title": "收集选中文本",
        "icon": "$(selection)",
        "category": "AI Writer"
      },
      {
        "command": "aiwriter.collectEntireFile",
        "title": "收集整个文件",
        "icon": "$(file)",
        "category": "AI Writer"
      },
      {
        "command": "aiwriter.clearSelections",
        "title": "清空收集的文本",
        "icon": "$(clear-all)",
        "category": "AI Writer"
      },
      {
        "command": "aiwriter.acceptDiff",
        "title": "接受差异",
        "icon": "$(check)",
        "category": "AI Writer"
      },
      {
        "command": "aiwriter.rejectDiff",
        "title": "拒绝差异",
        "icon": "$(x)",
        "category": "AI Writer"
      },
      {
        "command": "aiwriter.showSidebar",
        "title": "显示 AI Writer 侧边栏",
        "category": "AI Writer"
      },
      {
        "command": "aiwriter.addFileToChat",
        "title": "添加到 AI Writer 对话",
        "icon": "$(add)",
        "category": "AI Writer"
      },
      {
        "command": "aiwriter.buildRagIndex",
        "title": "构建 RAG 索引（长篇小说检索）",
        "icon": "$(database)",
        "category": "AI Writer"
      },
      {
        "command": "aiwriter.runNovelQaEvaluation",
        "title": "运行 NovelQA RAG 评测",
        "icon": "$(beaker)",
        "category": "AI Writer"
      },
      {
        "command": "aiwriter.runCLongEvalEvaluation",
        "title": "运行 CLongEval 中文小说 RAG 评测",
        "icon": "$(beaker)",
        "category": "AI Writer"
      },
      {
        "command": "aiwriter.organizeMarkdownProject",
        "title": "无损整理 Markdown 小说文件",
        "icon": "$(folder-library)",
        "category": "AI Writer"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "aiwriter.collectSelectedText",
          "when": "editorHasSelection",
          "group": "aiwriter"
        },
        {
          "command": "aiwriter.collectEntireFile",
          "when": "!editorHasSelection",
          "group": "aiwriter"
        }
      ],
      "view/title": [
        {
          "command": "aiwriter.newSession",
          "when": "view == aiwriter.sidebar",
          "group": "navigation"
        },
        {
          "command": "aiwriter.clearSelections",
          "when": "view == aiwriter.sidebar",
          "group": "aiwriter"
        }
      ],
      "commandPalette": [
        {
          "command": "aiwriter.showSidebar"
        }
      ],
      "explorer/context": [
        {
          "command": "aiwriter.addFileToChat",
          "when": "resourceScheme == file",
          "group": "aiwriter"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aiwriter.collectSelectedText",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorHasSelection"
      },
      {
        "command": "aiwriter.newSession",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      }
    ],
    "configuration": {
      "title": "AI Writer",
      "properties": {
        "aiwriter.autoSaveSessions": {
          "type": "boolean",
          "default": true,
          "description": "自动保存会话"
        },
        "aiwriter.maxSelections": {
          "type": "number",
          "default": 10,
          "description": "最大收集文本数量"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node scripts/clean-out.js && tsc -p ./ && node scripts/copy-webview.js",
    "copy-webview": "node scripts/copy-webview.js",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "eval:agent": "npm run compile && node evals/run.cjs",
    "test:unit": "npm run compile && mocha --ui tdd --require out/test/node-vscode-stub.js \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.99.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^1.0.69",
    "@ai-sdk/deepseek": "^2.0.77",
    "@ai-sdk/moonshotai": "^2.0.69",
    "@ai-sdk/openai": "^3.0.131",
    "@ai-sdk/openai-compatible": "^2.0.87",
    "@vscode/ripgrep": "^1.18.0",
    "ai": "^6.0.315",
    "ajv": "^6.14.0",
    "highlight.js": "^11.11.1",
    "ignore": "^5.3.2",
    "langsmith": "0.3.87",
    "marked": "^18.0.1",
    "tiktoken": "^1.0.22",
    "vectra": "0.12.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/valleyxht/aiwriter-vscode.git"
  }
}
